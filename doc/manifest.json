{
  "manifest_version": 3,
  "name": "Extração de Informações do IXC - claude opt",
  "version": "0.1",
  "description": "Extrai do IXC informações como retrabalho, pontos cabeados e etc",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "sidePanel",
    "scripting",
    "tabs",
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://ixc.ampernet.com.br/*",
    "https://sheets.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "296780058563-ih6d5g7cpim50r1ud64i1fbpluhh33st.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ext IXC"
  },
  "side_panel": {
    "default_path": "painel.html"
  }
}
